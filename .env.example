# .env.example — Gram Saathi
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6LtYAjF7C3f-undJIb3WARVSg-dKkaux8ucCnQTEo7Q5Q
GEMINI_MODEL=gemini-2.0-flash

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_CITIZEN_EXPIRE_MINUTES=60
JWT_OFFICER_EXPIRE_MINUTES=480

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default for MVP):
DATABASE_URL=sqlite+aiosqlite:///./gram_saathi.db
# PostgreSQL (production, change dialect only):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gram_saathi

# ─── Application Mode ────────────────────────────────────────────────────────
# SIMULATION_MODE=true means ALL external submissions are simulated.
# Never set to false in MVP — there are no real government API credentials.
SIMULATION_MODE=true

# DEMO_MODE=true seeds synthetic citizen data (Ramu + Priya) on startup.
DEMO_MODE=true

# ─── WhatsApp (optional) ─────────────────────────────────────────────────────
# Leave blank to use the built-in WhatsApp simulator.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=gram-saathi-webhook-verify

# ─── Storage ─────────────────────────────────────────────────────────────────
# Relative to project root. Must be outside web root. Gitignored.
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=5

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── OCR ─────────────────────────────────────────────────────────────────────
# Path to Tesseract executable (auto-detected on most systems)
# TESSERACT_CMD=/usr/bin/tesseract

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AI_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# WARNING: Never set LOG_LEVEL=DEBUG in production — debug logs may contain sensitive data
